DATABASE_URL="postgresql://user:password@host:5432/kiambani?sslmode=require"
SESSION_SECRET="generate a long random string, e.g. `openssl rand -base64 48`"

# Africa's Talking SMS (used for emergency broadcasts). Leave AFRICASTALKING_API_KEY
# blank to run without real SMS delivery — announcements will still post in-app.
AFRICASTALKING_API_KEY=""
AFRICASTALKING_USERNAME="sandbox"
AFRICASTALKING_SENDER_ID=""
